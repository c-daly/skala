  </link>
  <joint name="left_track_fixed" type="fixed">
    <parent link="base_link" />
    <child link="left_track" />
    <origin xyz="0 0.143 0.02" rpy="0 0 0" />
  </joint>
  <link name="right_track">
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/right_track_track.stl" />
      </geometry>
      <material name="right_track_track">
        <color rgba="0.11 0.12 0.135 1" />
