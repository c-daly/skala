<?xml version='1.0' encoding='utf-8'?>
<robot name="skala">
  <link name="base_footprint" />
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/base_link_black.stl" />
      </geometry>
      <material name="base_link_black">
        <color rgba="0.075 0.085 0.1 1" />
      </material>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/base_link_board.stl" />
      </geometry>
      <material name="base_link_board">
        <color rgba="0.08 0.28 0.16 1" />
      </material>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/base_link_metal.stl" />
      </geometry>
      <material name="base_link_metal">
        <color rgba="0.45 0.48 0.5 1" />
