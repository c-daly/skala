    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/base_link_red.stl" />
      </geometry>
      <material name="base_link_red">
        <color rgba="0.58 0.065 0.045 1" />
      </material>
    </visual>
  </link>
  <joint name="base_link_fixed" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0.0204111869" rpy="0 0 0" />
  </joint>
  <link name="left_track">
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/left_track_track.stl" />
      </geometry>
      <material name="left_track_track">
        <color rgba="0.11 0.12 0.135 1" />
