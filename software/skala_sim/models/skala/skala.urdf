    <child link="camera_optical_frame" />
    <origin xyz="0.008 0 0.002" rpy="-1.57079633 0 -1.57079633" />
  </joint>
  <link name="lidar_link" />
  <joint name="lidar_link_fixed" type="fixed">
    <parent link="base_link" />
    <child link="lidar_link" />
    <origin xyz="0.008 0 0.1885" rpy="0 0 0" />
  </joint>
  <link name="imu_link" />
  <joint name="imu_link_fixed" type="fixed">
