    </visual>
  </link>
  <joint name="right_track_fixed" type="fixed">
    <parent link="base_link" />
    <child link="right_track" />
    <origin xyz="0 -0.143 0.02" rpy="0 0 0" />
  </joint>
  <link name="camera_pan_link">
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/camera_pan_link_black.stl" />
      </geometry>
      <material name="camera_pan_link_black">
        <color rgba="0.075 0.085 0.1 1" />
      </material>
    </visual>
  </link>
  <joint name="camera_pan_joint" type="revolute">
    <parent link="base_link" />
    <child link="camera_pan_link" />
    <origin xyz="0.108 0 0.033" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5707963267948966" upper="1.5707963267948966" effort="1" velocity="1.5" />
  </joint>
  <link name="camera_tilt_link">
    <visual>
      <geometry>
        <mesh filename="package://skala_sim/models/skala/meshes/camera_tilt_link_black.stl" />
      </geometry>
      <material name="camera_tilt_link_black">
